# Copia este archivo a .env solo si necesitas apuntar a un backend distinto del de producción.
#   cp .env.example .env
#
# El valor por defecto vive en app.json (`extra.apiBaseUrl` = https://api.stevengazo.co.cr) y no
# hace falta tocar nada para usarlo. Esta variable lo pisa al compilar el bundle, y el usuario
# siempre puede cambiarlo después en Ajustes → Conexión, que manda sobre ambos.
#
# Ojo con el prefijo EXPO_PUBLIC_: se incrusta en el bundle en texto plano y cualquiera que
# tenga el .apk/.ipa puede leerlo. Vale para una URL pública; NUNCA metas aquí claves.
#
# Contra un backend local: desde un emulador de Android el PC anfitrión es 10.0.2.2, no
# localhost. Desde un móvil físico, usa la IP de tu equipo en la wifi y arranca el backend
# escuchando en 0.0.0.0.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5107
